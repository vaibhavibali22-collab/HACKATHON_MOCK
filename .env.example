# Copy to .env and fill in. NEVER commit .env or real keys.

# Database (default: local SQLite file in the repo root, git-ignored)
DATABASE_URL=sqlite:///./tickets.db

# Groq API
GROQ_API_KEY=
# Must be set explicitly. Pick a model that is currently available to YOUR API tier:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Do not copy a model ID from old docs or tutorials; models get deprecated.
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=30

# Where the Streamlit frontend finds the FastAPI backend
API_BASE_URL=http://localhost:8000

# Minimum top-1 similarity (0.0-1.0) required before the LLM is called.
# Below this, /resolve returns generation_status="insufficient_evidence".
# 0.10 is an UNTUNED starting value; calibrate against the seeded data.
RELEVANCE_THRESHOLD=0.10
